{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoxCount Packing Tips Article",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "category", "readingTime", "title", "summary", "seoTitle", "metaDescription", "focusKeyword", "canonicalPath", "hero", "relatedSlugs", "sections"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "category": { "type": "string", "minLength": 1 },
    "readingTime": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "seoTitle": { "type": "string", "minLength": 1 },
    "metaDescription": { "type": "string", "maxLength": 160 },
    "focusKeyword": { "type": "string", "minLength": 1 },
    "canonicalPath": { "type": "string", "pattern": "^/" },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt", "caption"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 },
        "caption": { "type": "string", "minLength": 1 }
      }
    },
    "relatedSlugs": { "type": "array", "items": { "type": "string" } },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading", "content"],
        "properties": {
          "heading": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  }
}
